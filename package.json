{
  "name": "eslint-plugin-nest-drift",
  "version": "0.1.2",
  "description": "ESLint rules that catch drift between class-validator / class-transformer / Swagger decorators and TypeScript types in NestJS",
  "license": "MIT",
  "author": "Kerim <kerimakmyradov28@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerimakmyradov/eslint-plugin-nest-drift.git"
  },
  "homepage": "https://github.com/kerimakmyradov/eslint-plugin-nest-drift#readme",
  "bugs": "https://github.com/kerimakmyradov/eslint-plugin-nest-drift/issues",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "nestjs",
    "class-validator",
    "class-transformer",
    "swagger",
    "dto",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.1"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0",
    "typescript": ">=5.4.0 <6.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@nestjs/common": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
